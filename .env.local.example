# Copy this to .env.local and fill in real values.
# Restore from Codespace secrets: gh secret list -a codespaces
# NEVER commit .env.local or any file containing real credential values.

# Supabase — infrastructure
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_URL=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Supabase — server-side only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Supabase — Next.js client (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Livepeer
LIVEPEER_API_KEY=
NEXT_PUBLIC_LIVEPEER_PLAYBACK_BASE=https://livepeer.studio

# Mux — server-side only (never expose to browser)
# MUX_TOKEN_ID and MUX_TOKEN_SECRET: from Mux dashboard → Settings → Access Tokens
# MUX_WEBHOOK_SECRET: from Mux dashboard → Settings → Webhooks → signing secret
# NEXT_PUBLIC_APP_URL: your production domain (used for Mux Direct Upload CORS origin)
MUX_TOKEN_ID=e5f0b0ba-6c97-4a2d-8f92-f667ad21c91b
MUX_TOKEN_SECRET=rUVdahjlm+okAkg943pIBITD6GeIKX1TWFY4y778wNJ+4RuKtWERQgX1ezjEQnfhGLhr4pjb9ug
MUX_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=mighty-verse-reimagined.vercel.app

# ISRC registrant — server-side only (never expose to browser)
# Optional: if set, POST /api/authority/isrc/seed will create the registrant
# if no active registrant exists in the database.
# The DB record always takes precedence over these env vars at runtime.
# ISRC_REGISTRANT_PREFIX must be exactly 5 uppercase alphanumeric chars
# (2-letter country code + 3-char registrant code, e.g. ZA001)
ISRC_REGISTRANT_PREFIX=
ISRC_REGISTRANT_NAME=

# thirdweb — server-side only (never expose to browser)
THIRDWEB_SECRET_KEY=
SERVER_WALLET_PRIVATE_KEY=

# thirdweb — client-side publishable key (safe to expose)
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=

# Vercel — deployment credential (never expose to browser)
VERCEL_TOKEN=
