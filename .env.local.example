# Copy this to .env.local and fill in real values.
# Restore from Codespace secrets: gh secret list -a codespaces
# NEVER commit .env.local or any file containing real credential values.

# Supabase — infrastructure
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_URL=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Supabase — server-side only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Supabase — Next.js client (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Livepeer
LIVEPEER_API_KEY=
NEXT_PUBLIC_LIVEPEER_PLAYBACK_BASE=https://livepeer.studio

# thirdweb — server-side only (never expose to browser)
THIRDWEB_SECRET_KEY=
SERVER_WALLET_PRIVATE_KEY=

# thirdweb — client-side publishable key (safe to expose)
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=

# Vercel — deployment credential (never expose to browser)
VERCEL_TOKEN=
